{
  "name": "@hermers/grpc",
  "version": "2.1.0",
  "description": "Official Hermes gRPC SDK — native TLS client generated from proto3 (API key auth)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "node ../../scripts/generate-grpc.mjs",
    "test": "tsx --test tests/grpc.test.ts tests/live.test.ts",
    "test:unit": "tsx --test tests/grpc.test.ts",
    "test:live": "tsx --test tests/live.test.ts"
  },
  "keywords": [
    "hermes",
    "hermers",
    "grpc",
    "proto3",
    "email",
    "contacts",
    "storage"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@grpc/grpc-js": "^1.14.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
