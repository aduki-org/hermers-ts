{
  "name": "@hermers/sdk",
  "version": "2.0.0",
  "description": "Official Hermes REST SDK — Stripe-style TypeScript client (API key auth)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/sdk.test.ts tests/live.test.ts",
    "test:unit": "tsx --test tests/sdk.test.ts",
    "test:live": "tsx --test tests/live.test.ts"
  },
  "keywords": [
    "hermes",
    "hermers",
    "sdk",
    "rest",
    "api",
    "email",
    "contacts",
    "mail"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
