{
  "name": "hermers-sdk-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "generate": "node scripts/generate-grpc.mjs",
    "build": "npm run generate && npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs": "npm run docs:build && npm run docs:check"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "ts-proto": "^2.7.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  }
}
